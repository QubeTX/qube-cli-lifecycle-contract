{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:qubetx:cli-lifecycle:completion-receipt:v2",
  "title":"Qube Lifecycle Completion Receipt v2",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","product_id","contract_version","contract_commit","source_commit","candidate_version","environment","rows","terminal_status"],
  "properties": {
    "schema":{"const":"qubetx.cli-lifecycle.completion-receipt.v2"},
    "product_id":{"type":"string","minLength":1},
    "contract_version":{"const":"2.0.1"},
    "contract_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "source_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "candidate_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "environment":{"type":"string","minLength":1},
    "rows": {
      "type":"array", "minItems":1,
      "items": {
        "type":"object", "additionalProperties":false,
        "required":["criterion","obligations","oracle","invocation","evidence","interpretation","limitation","status"],
        "properties": {
          "criterion":{"type":"string","minLength":1},
          "obligations":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[A-Z]+-[0-9]{3}$"}},
          "oracle":{"type":"string","minLength":1},
          "invocation":{"type":"string","minLength":1},
          "evidence":{"type":"string","minLength":1},
          "interpretation":{"type":"string","minLength":1},
          "limitation":{"type":"string"},
          "status":{"enum":["PASS","FAIL","NOT_RUN","INDETERMINATE"]}
        }
      }
    },
    "terminal_status":{"enum":["VERIFIED","PARTIAL","BLOCKED","REFUTED","INDETERMINATE","UNVERIFIED"]}
  }
}
